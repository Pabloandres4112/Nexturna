# Dockerfile para desarrollo con hot reload.
# Mismas versiones fijas de Node/pnpm que Dockerfile (produccion) a proposito:
# el objetivo es que "funciona en mi contenedor de dev" siga siendo cierto en prod.
FROM node:22.12.0-alpine3.21

# Herramientas de compilacion nativa (bcrypt compila un addon nativo en install).
RUN apk add --no-cache python3 make g++

RUN npm install -g pnpm@10.28.0

WORKDIR /app

# Copia archivos de dependencias
COPY package.json pnpm-lock.yaml ./

# Instala dependencias
RUN pnpm install --frozen-lockfile

# Copia el código fuente
COPY . .

# Expone el puerto
EXPOSE 3000

# Comando de desarrollo con hot reload
CMD ["pnpm", "run", "start:dev"]
